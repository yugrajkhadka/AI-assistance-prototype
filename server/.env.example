# Server Environment Variables
# Copy this to .env and fill in real values

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cineassist

# JWT
JWT_SECRET=your-jwt-secret-change-in-production

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated allowed origins (GitHub Pages is allowed by default)
CORS_ORIGIN=https://yugrajkhadka.github.io

# Storage (set to 's3' for production)
STORAGE_MODE=local

# AWS S3 (only needed if STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=cineassist-uploads
