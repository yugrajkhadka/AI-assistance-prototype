# Server Environment Variables
# Copy this to .env and fill in real values

# MongoDB (optional for local development; app falls back to a local JSON store if unavailable)
MONGODB_URI=mongodb://localhost:27017/cineassist

# JWT
JWT_SECRET=your-jwt-secret-change-in-production

# Claude (Anthropic) — primary AI provider for script analysis when set.
# Get a key at https://console.anthropic.com/ ; if Claude fails, Ollama is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Local Ollama (fallback if Claude and TokenRouter are unset or fail)
LOCAL_LLM_API_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT_MS=180000
OLLAMA_BASE_URL=http://localhost:11434

# TokenRouter (cloud, tried first if TOKENROUTER_API_KEY is set)
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=qwen/qwen3.8-max-free

# Legacy Google API setting (unused in local Ollama mode)
GOOGLE_API_KEY=

# Server
PORT=3002
NODE_ENV=development

# CORS — comma-separated allowed origins (GitHub Pages is allowed by default)
CORS_ORIGIN=https://yugrajkhadka.github.io

# Storage (set to 's3' for production)
STORAGE_MODE=local

# AWS S3 (only needed if STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=cineassist-uploads

# Full report PDF export (prints the web app with your installed Chrome)
REPORT_BASE_URL=http://localhost:5173/AI-assistance-prototype/
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
